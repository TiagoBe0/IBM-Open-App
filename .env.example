# =====================================================================
# Variables de entorno requeridas para Google OAuth2
# Copia este archivo como .env y rellena los valores reales.
# NUNCA commitees el archivo .env al repositorio.
# =====================================================================

# -- Google OAuth2 --
# Obtén estas credenciales en:
# https://console.cloud.google.com/ > APIs & Services > Credentials
# Tipo de credencial: "OAuth 2.0 Client ID" (aplicación web)

GOOGLE_CLIENT_ID=119068809876-1ebebl5jq21sobihpuuk04rvan0hib97.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI

# -- URI de redirección a añadir en Google Cloud Console --
# En la sección "Authorized redirect URIs" de tu credencial OAuth2,
# añade exactamente estas URIs (según tu entorno):
#
#   Desarrollo local:  http://localhost:8081/login/oauth2/code/google
#   Producción:        https://tu-dominio.com/login/oauth2/code/google
